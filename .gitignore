# ---------------------------------------------------------------------------
# Theos build output
# ---------------------------------------------------------------------------
.theos/
packages/

# theos also drops empty object-directory stamps *next to* a subproject when
# that subproject compiles sources from outside its own directory, which
# FBPNotifyBridge/src does (it shares src/PluginsInject/ and src/Core/fishhook/
# with the root tweak). These are build droppings, not source.
FBPNotifyBridge/src/src/

# ---------------------------------------------------------------------------
# Packaging artifacts (build.py)
#   - Facebook-Plus.deb : the renamed package build.py produces
#   - package/          : legacy output directory name, kept ignored for safety
# ---------------------------------------------------------------------------
Facebook-Plus.deb
package/

# ---------------------------------------------------------------------------
# Editor / IDE support
#   compile_commands.json is generated by `make compile-commands`; it holds
#   absolute paths to whoever's theos install built it, so it is per-machine.
#   .clangd and .cache/ are that indexer's local state. .clangd is regenerated
#   from scratch each time `make compile-commands` runs (with this machine's
#   theos path and SDK baked in), so it is per-machine and never committed.
# ---------------------------------------------------------------------------
compile_commands.json
.cache/
.clangd

# ---------------------------------------------------------------------------
# Python tooling and caches
#   venv/         : local virtualenv, if any
#   pyrefly.toml  : per-user type-checker config
# ---------------------------------------------------------------------------
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
pyrefly.toml
test/*.py

# ---------------------------------------------------------------------------
# Test inputs
#   The decrypted Facebook IPA is copyrighted and machine-local — never commit it.
# ---------------------------------------------------------------------------
test/*
!test/README.md
# The scripts in test/ drive *this* phone and stay machine-local. The project's
# build and verify tooling lives in build.py and scripts/ instead; run the test
# suite with `python3 scripts/verify.py test`.

# ---------------------------------------------------------------------------
# IPA files, anywhere in the tree
#   An injected IPA carries Facebook's own application, which is not ours to
#   distribute. It must never be committed and must never reach a release.
#   See .github/RELEASE-POLICY.md.
# ---------------------------------------------------------------------------
*.ipa


# ---------------------------------------------------------------------------
# Local-only dev files
#   draft/   : work-in-progress notes and mockups
#   .temp/   : scratch clones
#   .agent/, AGENT.md : AI agent notes
#   preview/ : XcodeGen UI preview harness (dev tool, not part of the build)
# ---------------------------------------------------------------------------
draft/
.temp/
.agent/
AGENT.md
preview/
# ---------------------------------------------------------------------------
# Local device/build config
#   .env carries this machine's device IPs, UDIDs and SSH key path — local only,
#   never commit it. .env.example is the tracked, placeholder-only template.
# ---------------------------------------------------------------------------
.env

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
