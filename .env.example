# Facebook Plus — local device/build config (template).
#
# Copy this to .env (which is gitignored) and fill in your own values:
#     cp .env.example .env
#
# build.py and scripts/verify.py load .env automatically from the repo root, so
# once it is filled in you can drop the --host / --key / -u flags:
#     python3 build.py --rootless --install --ssh
#
# Keep real IPs and UUIDs in .env only — never in this tracked template.

# -- Jailbroken test device (rootless /var/jb), reached over Wi-Fi --------------
# Used by `build.py --ssh` and `scripts/verify.py device` to dpkg the rootless
# .deb. Find the IP in Settings > Wi-Fi > (i) on the device.
SSH_HOST=192.168.1.123
# SSH private key whose public half is in the device's root authorized_keys.
SSH_KEY=~/.ssh/id_ed25519

# -- Device UUIDs for --install targets ----------------------------------------
# List devices with:  xcrun devicectl list devices
# Jailbroken device (SSH .deb install):
JAILBROKEN_UUID=XXXXXXXX-XXXXXXXXXXXXXXXX
# Sideload device (signed IPA install over USB):
SIDELOAD_UUID=XXXXXXXX-XXXXXXXXXXXXXXXX
